# Shared login password (D-009)
APP_PASSWORD=
# Secret for signing the session cookie (D-009)
SESSION_SECRET=
# Upstash Redis for favourites (D-008, D-041). The Vercel Marketplace integration injects
# KV_REST_API_URL / KV_REST_API_TOKEN instead; either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
